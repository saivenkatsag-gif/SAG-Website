{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blogs"
    }
  ]
}
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blogs.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
