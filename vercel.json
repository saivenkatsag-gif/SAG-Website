{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/test-redirect",
      "destination": "https://google.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog/:slug",
      "destination": "/blogs.html"
    }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
